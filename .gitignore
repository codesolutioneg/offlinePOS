#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release
.claude/worktrees/
.jez/

# Screenshots the harness writes; regenerate with tool/run_shots.sh rather than
# carrying binaries in the history.
/.shots/
/.shots-fresh/

# Code-signing material. The pfx holds the private key that signs as us.
*.pfx
*.cer
*.pfx.base64.txt

# Screenshot tour output (generated by tool/run_shots.sh)
.shots-tour/

# Local station packages / scratch
/dist/
/test_out.txt

# ZK agent local bootstrap (downloaded per till)
tools/.py311/
tools/.venv311/
tools/zk_setup_status.json
tools/**/__pycache__/
tools/*.pyc
