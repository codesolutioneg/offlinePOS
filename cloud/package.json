{
  "name": "offlinepos-backup-server",
  "version": "1.0.0",
  "private": true,
  "description": "Stores the encrypted whole-till backups the Offline POS tills upload.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.json",
    "start": "node dist/src/server.js",
    "dev": "tsx watch src/server.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "migrate": "prisma migrate deploy",
    "shop:create": "node dist/scripts/create-shop.js",
    "shop:list": "node dist/scripts/list-shops.js"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/static": "^8.3.0",
    "@prisma/client": "^6.16.2",
    "fastify": "^5.6.1",
    "prisma": "^6.16.2"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
