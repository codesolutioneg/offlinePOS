# Copy to .env and fill in. Never commit .env.

# Long random strings: openssl rand -hex 32
POSTGRES_PASSWORD=
ADMIN_TOKEN=

# Largest single backup accepted, in MB.
MAX_BACKUP_MB=1024

# Where the API listens on the host. Behind a reverse proxy in another container,
# use the docker bridge address (172.17.0.1); otherwise keep 127.0.0.1.
BIND_ADDRESS=127.0.0.1
API_PORT=4555

# Tax upload (Dishflow ETA). Leave empty to disable until ready.
# FIREBASE_PROJECT_ID=pos-test-70970
# FIREBASE_SERVICE_ACCOUNT_FILE=/secrets/pos-test-70970-tax-sa.json
# FIREBASE_SA_HOST_PATH=/root/.offlinepos
# ETA_PROXY_BASE=https://pos-test-70970.web.app
# TAX_DEFAULT_CONNECTION_ID=yFsBtvlradoAkKSascZ3
